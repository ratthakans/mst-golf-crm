{
  "name": "mst-golf-crm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @mstgolf/database db:generate",
    "db:migrate": "pnpm --filter @mstgolf/database db:migrate",
    "db:seed": "pnpm --filter @mstgolf/database db:seed",
    "db:studio": "pnpm --filter @mstgolf/database db:studio",
    "db:reset": "pnpm --filter @mstgolf/database db:reset"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.16.0"
  }
}

{
  "name": "@mstgolf/shared",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tiers": "./src/tiers.ts",
    "./phone": "./src/phone.ts"
  },
  "typesVersions": {
    "*": {
      "tiers": [
        "src/tiers.ts"
      ],
      "phone": [
        "src/phone.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "vitest": "^2.1.0",
    "typescript": "^5.6.0"
  }
}

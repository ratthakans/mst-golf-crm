{
  "name": "@mstgolf/database",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:deploy": "node --env-file-if-exists=../../.env.local scripts/prisma.mjs migrate deploy",
    "db:status": "node --env-file-if-exists=../../.env.local scripts/prisma.mjs migrate status",
    "db:seed": "node --env-file-if-exists=../../.env.local scripts/prisma.mjs db seed",
    "db:studio": "node --env-file-if-exists=../../.env.local scripts/prisma.mjs studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "admin:create": "node --env-file-if-exists=../../.env.local --import tsx prisma/create-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@mstgolf/shared": "workspace:*",
    "@mstgolf/analytics": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "typescript": "^5.6.0"
  }
}

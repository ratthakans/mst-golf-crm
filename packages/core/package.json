{
  "name": "@mstgolf/core",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./time": "./src/time.ts",
    "./money": "./src/money.ts"
  },
  "typesVersions": {
    "*": {
      "time": [
        "src/time.ts"
      ],
      "money": [
        "src/money.ts"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=../../.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "demo": "node --env-file-if-exists=../../.env.local --import tsx scripts/demo.ts"
  },
  "dependencies": {
    "@mstgolf/database": "workspace:*",
    "@mstgolf/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}

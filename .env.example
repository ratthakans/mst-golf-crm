# MST Golf Platform — environment variables.
# Local: copy to .env.local at the repo root (apps/web-admin/.env.local is a
# symlink to it). Vercel: set per environment in each project.

# --- Database (Neon, Singapore) ---------------------------------------------
# One Neon database holds every environment, each in its own Postgres schema:
#   production → public · preview → preview · local dev → dev · tests → test_*
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SCHEMA=dev
# Migrate:  pnpm db:deploy           (uses DATABASE_SCHEMA; refuses public)
#           DATABASE_SCHEMA=public ALLOW_PRODUCTION=1 pnpm db:deploy   (production)

# --- Tenant -------------------------------------------------------------------
ORG_SLUG=mst-golf

# --- Security -----------------------------------------------------------------
# Staff session cookie (back office). 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=
# Customer session cookie (apps/web). Different value from AUTH_SECRET.
CUSTOMER_AUTH_SECRET=
# Encrypts LINE channel secrets at rest. 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Vercel Cron and the GitHub Actions cron send "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# --- First Super Admin (db:seed) ----------------------------------------------
# Recovery at any time: pnpm --filter @mstgolf/database admin:create <email>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Files --------------------------------------------------------------------
# PRIVATE Blob store for member photos (PDPA) — served only through the back office.
BLOB_READ_WRITE_TOKEN=
# PUBLIC Blob store for website images (article covers). Optional: without it,
# staff paste an image URL instead of uploading.
PUBLIC_BLOB_READ_WRITE_TOKEN=

# --- LINE ---------------------------------------------------------------------
# LINE credentials are NOT env vars: Super Admin enters them at
# Settings › LINE (stored encrypted). For local work without LINE:
LINE_DEV_LOGIN=1
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# --- Out of the Phase 1 contract (intelligence pages, hidden by default) ------
ANTHROPIC_API_KEY=
AI_MODEL=
